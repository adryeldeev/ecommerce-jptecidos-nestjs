NODE_ENV=production
PORT=3001

# Prefer managed database in production
DATABASE_URL="postgresql://postgres:changeme@postgres:5432/jptecidos?schema=public"

JWT_SECRET="change-this-to-a-long-random-secret"
JWT_EXPIRES_IN="1d"
BCRYPT_ROUNDS=12
ADMIN_EMAIL="admin@jptecidos.com"
ADMIN_PASSWORD="change-this-admin-password"
ADMIN_NAME="Administrador"

KAFKA_ENABLED=true
KAFKA_BROKERS=""
KAFKA_CLIENT_ID="ecommerce-api"
KAFKA_GROUP_ID="ecommerce-api-consumer"
KAFKA_PAYMENT_GROUP_ID="ecommerce-payment-producer"

# Optional: Kafka auth for managed clusters
KAFKA_SASL_ENABLED=false
KAFKA_SASL_MECHANISM="plain"
KAFKA_USERNAME=""
KAFKA_PASSWORD=""
KAFKA_SSL_ENABLED=false

PAYMENT_AUTO_APPROVE_WITHOUT_GATEWAY=false

STORAGE_DRIVER="s3"
AWS_REGION="us-east-1"
AWS_S3_BUCKET=""
AWS_S3_PUBLIC_BASE_URL=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_WEBHOOK_SECRET=""

FRENET_TOKEN=""
FRENET_SELLER_CEP=""

RESEND_API_KEY=""
RESEND_FROM_EMAIL="pedidos@jptecidos.com.br"
NOTIFICATION_EMAIL=""

POSTGRES_DB="jptecidos"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="changeme"
